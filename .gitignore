# Traveloop — Git Ignore Rules

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.coverage
htmlcov/
*.log

# Virtual environment
venv/
env/
.venv/

# Database (local SQLite — not committed)
*.db
Database/*.db

# Environment variables
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local workflow notes
workflow_checklist.md

# Uploads (user-generated content)
frontend/static/uploads/*
!frontend/static/uploads/.gitkeep

# Frontend build output and dependencies
frontend/dist/
node_modules/
